<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>CreativeNotch</string>
  <key>CFBundleDisplayName</key><string>CreativeNotch</string>
  <key>CFBundleExecutable</key><string>CreativeNotch</string>
  <!-- A loose .icns in Contents/Resources, copied by Scripts/bundle.sh.
       CFBundleIconName is deliberately absent: it addresses an entry in a
       compiled asset catalog, and this bundle is assembled by hand. -->
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIdentifier</key><string>com.gcdz.creativenotch</string>
  <key>CFBundleVersion</key><string>1</string>
  <!-- Substituted by Scripts/bundle.sh from CoreInfo.version. -->
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>

  <!-- The camera module. Without this key macOS TERMINATES the process the
       moment a capture session is built -- it is not an optional courtesy.
       Note there is deliberately NO NSMicrophoneUsageDescription: clips are
       silent, which avoids a second permission prompt, the orange recording
       indicator, and a self-exclusion problem for the planned microphone
       indicator. -->
  <key>NSCameraUsageDescription</key><string>CreativeNotch shows the camera in the notch, so you can check your framing or take a quick photo or clip. Nothing is uploaded; captures are saved to the file shelf.</string>

  <!-- Reaction Effects are on by default for every app on macOS, so a hand
       gesture would produce confetti in a framing mirror. This sets the
       DEFAULT only: Apple documents it as applying "until such time that the
       user makes their own selection in Control Center", so it is not a
       guarantee. -->
  <key>NSCameraReactionEffectGesturesEnabledDefault</key><false/>
</dict>
</plist>
