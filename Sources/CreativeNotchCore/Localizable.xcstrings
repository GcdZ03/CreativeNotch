    "CreativeNotch can't read your Downloads folder, so it can't see downloads. Allow it in System Settings › Privacy & Security › Files & Folders, then reopen Settings or switch this off and on." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CreativeNotch can't read your Downloads folder, so it can't see downloads. Allow it in System Settings › Privacy & Security › Files & Folders, then reopen Settings or switch this off and on."
          }
        }
      }
    },
    "CreativeNotch can't read your calendars" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CreativeNotch can't read your calendars"
          }
        }
      }
    },
    "CreativeNotch could not listen for shortcuts. Restarting the app usually fixes this." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CreativeNotch could not listen for shortcuts. Restarting the app usually fixes this."
          }
        }
      }
    },
    "CreativeNotch looks for a new release when it opens, when you come back to your Mac and when you open Settings — the last two at most once a day — and never on a timer. Update Now downloads the release, checks its checksum, signature and version, and replaces this copy; if anything fails, the current copy stays. Each release is signed ad hoc, so macOS may ask again for permissions you had already granted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CreativeNotch looks for a new release when it opens, when you come back to your Mac and when you open Settings — the last two at most once a day — and never on a timer. Update Now downloads the release, checks its checksum, signature and version, and replaces this copy; if anything fails, the current copy stays. Each release is signed ad hoc, so macOS may ask again for permissions you had already granted."
          }
        }
      }
    },
